        <mxCell id="dept" value="&lt;b&gt;Кафедра&lt;/b&gt;&lt;hr&gt;БК  жазба коды : бүтін сан&lt;br&gt;БМ  атауы : мәтін (150)&lt;br&gt;коды : мәтін (30) бірегей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E3;fontColor=#172B4D;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
